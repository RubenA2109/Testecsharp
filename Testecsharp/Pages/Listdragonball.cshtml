@page
@model IndexModel
@{
}

<h1>DragonBall</h1>

@if (Model.Caracteres?.Count > 0)
{
    <div style="display: flex; flex-wrap: wrap;">
        @foreach (Models.DragonBallModel dragonball in Model.Caracteres)
        {
            <div style="border: 1px solid #ccc; margin: 10px; padding: 10px; width: 200px;">
                <p>Código: @dragonball.id</p>
                <p><strong>@dragonball.name</strong></p>
                <img src="@dragonball.image" />
            </div>
        }
    </div>
}
else
{
    <p>ERRO: não temos lista</p>
}